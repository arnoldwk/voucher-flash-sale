# =============================================================
# Local development environment
# Copy to .env and adjust if needed:
#   cp .env.example .env
# The Makefile auto-loads .env for every `make run-*` target.
# =============================================================

# ---- PostgreSQL (matches docker-compose.yml) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=flashsale
POSTGRES_SSLMODE=disable

# ---- Redis ----
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ---- JWT (must match between auth-service and campaign-service) ----
JWT_SECRET=salt-hackathon-jwt-secret-key-32bytes

# ---- Internal service-to-service auth ----
INTERNAL_API_KEY=salt-hackathon-internal-secret
CUSTOMER_SERVICE_URL=http://localhost:8085
ENABLE_DEMO_OTP=true

# ---- Service ports ----
CAMPAIGN_SERVICE_PORT=8081
CLAIM_SERVICE_PORT=8082
VOUCHER_SERVICE_PORT=8083
AUTH_SERVICE_PORT=8084
CUSTOMER_SERVICE_PORT=8085
