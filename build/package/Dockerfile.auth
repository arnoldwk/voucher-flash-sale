# Multi-stage Docker build for Auth Service
FROM golang:1.23-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /app/bin/auth-service ./services/auth-service/cmd/server

FROM alpine:3.20
RUN apk --no-cache add ca-certificates curl
WORKDIR /app
COPY --from=builder /app/bin/auth-service /app/auth-service

EXPOSE 8084
ENTRYPOINT ["/app/auth-service"]
